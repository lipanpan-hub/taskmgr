@WS_HOST = localhost:3000

### WebSocket 连接测试
WEBSOCKET ws://{{WS_HOST}}

### WebSocket 发送消息 - 获取任务列表
WEBSOCKET ws://{{WS_HOST}}
Content-Type: application/json

{
  "type": "getTasks"
}

### WebSocket 发送消息 - 创建任务
WEBSOCKET ws://{{WS_HOST}}
Content-Type: application/json

{
  "type": "createTask",
  "data": {
    "name": "测试任务",
    "scriptPath": "C:\\test\\script.ps1",
    "trigger": {
      "type": "daily",
      "startTime": "09:00"
    }
  }
}

### WebSocket 发送消息 - 删除任务
WEBSOCKET ws://{{WS_HOST}}
Content-Type: application/json

{
  "type": "deleteTask",
  "data": {
    "taskName": "测试任务"
  }
}

### WebSocket 发送消息 - 同步任务
WEBSOCKET ws://{{WS_HOST}}
Content-Type: application/json

{
  "type": "syncTasks"
}
